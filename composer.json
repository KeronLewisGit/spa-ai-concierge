{
    "name": "keronlewis/spa-ai-concierge",
    "description": "AI content assistant (FAQs, meta, alt text via the Anthropic API) and a rule-based Treatment Finder for salon, spa and medspa WordPress sites.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Keron Lewis",
            "homepage": "https://keronlewis.dev"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "KeronLewis\\SpaAiConcierge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KeronLewis\\SpaAiConcierge\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './.local-wp/*' -not -path './dist/*' -print0 | xargs -0 -n1 php -l",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
